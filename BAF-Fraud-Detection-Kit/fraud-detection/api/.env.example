# Copy this file to `.env` in fraud-detection/ (or fraud-detection/api/, both
# are read by pydantic-settings since uvicorn is normally started from
# fraud-detection/) and fill in real values. NEVER commit the real `.env`.

# --- database ---------------------------------------------------------
# SQLite default: zero setup, good for a hackathon demo, single-process only.
# Swap to Postgres for anything shared/production -- one line, no code change:
#   DATABASE_URL=postgresql+psycopg://fraud_api:changeme@localhost:5432/fraud_api
DATABASE_URL=sqlite:///./api/fraud_api.db

# --- JWT ----------------------------------------------------------------
# REQUIRED for any deployment beyond a single local demo process. If unset,
# the API generates a random secret at startup and logs a loud warning --
# tokens will not survive a restart and multiple instances won't trust each
# other's tokens. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- MFA ------------------------------------------------------------------
# OFF by default so a local demo isn't locked out without a real
# authenticator app enrolled. Set to true for any real deployment -- ADMIN
# accounts should require TOTP MFA in production.
MFA_REQUIRED=false
MFA_ISSUER=BAF-Fraud-Detection-Kit

# Encryption key for TOTP secrets at rest (Fernet, symmetric, via the
# `cryptography` library -- free, local, no KMS). REQUIRED for any
# deployment beyond a single local demo process: if unset, the API
# generates a random key at startup and logs a loud warning -- any MFA
# secret encrypted under that ephemeral key becomes undecryptable (and that
# admin locked out of MFA login) after a restart. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# --- rate limiting ----------------------------------------------------
LOGIN_RATE_LIMIT=5/minute
PREDICT_RATE_LIMIT=30/minute

# --- CORS -----------------------------------------------------------------
# Comma-separated exact origins. Never "*".
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- uploads ------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
MAX_UPLOAD_ROWS=50000

# --- model integrity --------------------------------------------------
MODELS_DIR=models
MODEL_CHECKSUM_FILE=models/model_checksum.json
# Set true once a checksum has been recorded (api/scripts/record_model_checksum.py).
# False locally so /predict can still be exercised before that has happened.
ENFORCE_MODEL_CHECKSUM=false

# --- bootstrap admin (first run only, api/scripts/init_db.py) -----------
# Both required to create the first admin account. Leave blank to skip.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
